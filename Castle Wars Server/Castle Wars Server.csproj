<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Castle_Wars_Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- SharedCode lives in Unity; server compiles it directly to stay in sync. -->
  <!-- No UnityEngine types allowed inside SharedCode — see CLAUDE.md. -->
  <ItemGroup>
    <Compile Include="..\Castle Wars Project\Assets\SharedCode\**\*.cs" />
  </ItemGroup>

</Project>
